<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.org.learning</groupId>
    <artifactId>learning-bom</artifactId>
    <version>1.1.1</version>

    <packaging>pom</packaging>
    <name>LLM :: BOM</name>
    <description>Bill of Materials — single source of truth for all dependency versions</description>

    <properties>
        <spring-boot.version>4.1.0</spring-boot.version>
        <spring-cloud.version>2025.1.2</spring-cloud.version>
        <spring-ai.version>2.0.0</spring-ai.version>
        <resilience4j.version>2.3.0</resilience4j.version>
        <logstash-logback.version>9.0</logstash-logback.version>
        <testcontainers.version>1.21.4</testcontainers.version>
        <pdfbox.version>3.0.8</pdfbox.version>
        <poi-ooxml.version>5.5.1</poi-ooxml.version>
        <tess4j.version>5.19.0</tess4j.version>
        <anthropic-java.version>2.52.0</anthropic-java.version>
        <swagger-parser.version>2.1.45</swagger-parser.version>
        <micrometer-jvm-extras.version>0.3.0</micrometer-jvm-extras.version>
        <micrometer-context-propagation.version>1.2.1</micrometer-context-propagation.version>
        <shedlock.version>5.16.0</shedlock.version>
        <langchain4j-bom.version>1.18.0</langchain4j-bom.version>
        <avro.version>1.12.1</avro.version>
        <confluent.version>8.3.0</confluent.version>
        <langchain4j-redis.version>1.18.0-beta28</langchain4j-redis.version>
        <springdoc.version>3.0.3</springdoc.version>
        <zxing.version>3.5.4</zxing.version>
        <samstevens-totp.version>1.7.1</samstevens-totp.version>
        <jackson-databind-nullable.version>0.2.11</jackson-databind-nullable.version>
        <ojdbc.version>23.26.2.0.0</ojdbc.version>
    </properties>

    <dependencyManagement>
        <dependencies>

            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <dependency>
                <groupId>com.oracle.database.jdbc</groupId>
                <artifactId>ojdbc17</artifactId>
                <version>${ojdbc.version}</version>
            </dependency>

            <dependency>
                <groupId>io.github.resilience4j</groupId>
                <artifactId>resilience4j-spring-boot3</artifactId>
                <version>${resilience4j.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.resilience4j</groupId>
                <artifactId>resilience4j-reactor</artifactId>
                <version>${resilience4j.version}</version>
            </dependency>
